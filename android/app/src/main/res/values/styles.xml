<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thema terwijl het proces start (licht). Tot het eerste Flutter-frame
         zichtbaar. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Donkere statusbalkiconen op de lichte achtergrond; daarna zet de
             app ze zelf (AnnotatedRegion in lib/app.dart). -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Vensterthema achter de Flutter-UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
