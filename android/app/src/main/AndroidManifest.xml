<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Push (Android 13+ vraagt toestemming; PushController doet dat na het
         inloggen). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Verder alleen wat Firebase Messaging meebrengt (INTERNET, WAKE_LOCK,
         ACCESS_NETWORK_STATE, c2dm RECEIVE) en VIBRATE (meldingen). Foto's en
         bestanden kiezen gaat via de systeemkiezer: geen opslagtoestemming.
         Lijst en Data safety: docs/store/google-play.md. -->
    <!-- Geen back-up en geen overzetten naar een nieuw toestel: zie
         res/xml/data_extraction_rules.xml. Voorspellend terug (Android 13+):
         go_router en Flutter verwerken het terug-gebaar zelf. Eén PopScope in
         AppShell: zonder iets om te poppen (na een deep link) gaat terug naar
         het ouderscherm, net als de terugpil; op een tabwortel sluit het. -->
    <application
        android:label="Assistje"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Links worden door app_links + DeepLinkHandler afgehandeld, niet
                 door Flutters eigen deeplinking (die zou go_router de rauwe URL
                 geven, ook /magic/{token}). -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <!-- App Links: links naar assistje.nl en elk teamsubdomein openen de
                 app. Geverifieerd via https://<host>/.well-known/assetlinks.json
                 (vogels3 WellKnownController, config/mobile.php). Alleen paden
                 die de app zelf toont (zie DeepLinkMapper), ook de publieke
                 schermen: /meedoen/* (teamlink + bevestiglink uit de mail) en
                 /register/invite/* (uitnodiging), lib/features/join, en
                 /aanmelden (zelf een team aanmelden), lib/features/signup. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="assistje.nl" />
                <data android:host="*.assistje.nl" />
                <data android:pathPrefix="/magic/" />
                <data android:pathPrefix="/events/" />
                <data android:path="/agenda" />
                <data android:pathPrefix="/agenda/" />
                <data android:path="/notifications" />
                <data android:pathPrefix="/notifications/" />
                <data android:pathPrefix="/meedoen/" />
                <data android:pathPrefix="/register/invite/" />
                <data android:path="/aanmelden" />
                <data android:pathPrefix="/aanmelden/" />
            </intent-filter>
        </activity>
        <!-- FCM-meldingen op de achtergrond in hetzelfde kanaal als de
             voorgrondmeldingen (lib/core/push/local_notifier.dart,
             pushChannelId). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="assistje_default" />
        <!-- Meldingsicoon en -kleur voor FCM-meldingen op de achtergrond
             (dezelfde als voor voorgrondmeldingen, local_notifier.dart). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_assistje" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
