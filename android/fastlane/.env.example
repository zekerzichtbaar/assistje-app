# Kopieer naar android/fastlane/.env (gitignored) en vul in.
# fastlane laadt dit bestand automatisch.

# Google Play-serviceaccount (Google Cloud → IAM → Serviceaccounts → sleutel
# als JSON; daarna in Play Console → Gebruikers en rechten uitnodigen met
# rechten op deze app: releases beheren). Absoluut pad, buiten de repo.
PLAY_JSON_KEY_PATH=

# Optioneel
# PACKAGE_NAME=nl.assistje.app
# DART_DEFINES_FILE=env/prod.json
