# Kopieer naar ios/fastlane/.env (gitignored) en vul in.
# fastlane laadt dit bestand automatisch.

# Apple Developer Team ID (developer.apple.com → Membership, 10 tekens).
APPLE_TEAM_ID=

# App Store Connect API-sleutel (App Store Connect → Gebruikers en toegang →
# Integraties → App Store Connect API). Rol: Admin (nodig om via Xcode
# automatisch distributiecertificaat + provisioning profile te beheren).
ASC_KEY_ID=
ASC_ISSUER_ID=
# Absoluut pad naar het gedownloade AuthKey_<KEY_ID>.p8 (buiten de repo).
ASC_KEY_PATH=

# Optioneel
# APP_IDENTIFIER=nl.assistje.app
# DART_DEFINES_FILE=env/prod.json
